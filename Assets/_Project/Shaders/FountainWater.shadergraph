{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "b011d9629f32406c824f21f167c10f11",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "Stylized fountain waves",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": 350,
            "y": 0,
            "width": 340,
            "height": 500
        }
    },
    "m_Slots": [
        {
            "m_Id": "e82cb984676f4c12ab49c6a555021573"
        },
        {
            "m_Id": "70c70d74c3814eb09c77a1916b05faf7"
        },
        {
            "m_Id": "90bbaef9989e41cf829b2dd17c6e9899"
        },
        {
            "m_Id": "7d705acf7c244ecbbe87d740c79f22ef"
        },
        {
            "m_Id": "fb4de3930b4c4d239dce4633a7f5cdc8"
        },
        {
            "m_Id": "6a1148b61d014cec9738204cf6e2677b"
        },
        {
            "m_Id": "b89016c3a99f4a0b96717a1b61e39d64"
        },
        {
            "m_Id": "ab8061fcf15d4357b72c0449fc7dd137"
        },
        {
            "m_Id": "8221d6f712c44dddb8da3195dda57891"
        },
        {
            "m_Id": "bf557b75855c407a9cfee361658a8941"
        },
        {
            "m_Id": "375b8357e1464abda50696449ab89351"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "FountainWaves",
    "m_FunctionSource": "",
    "m_FunctionBody": "\nfloat t = _Time.y * WaveSpeed;\nfloat2 p = Position.xz;\nDisplaced = Position;\nDisplaced.y += sin(p.x*3.1+t)*cos(p.y*2.7-t)*WaveIntensity;\nfloat2 q = p*PatternScale + float2(t*.3,-t*.2);\nq += .32*float2(sin(q.y*1.6+t),cos(q.x*1.3-t));\nfloat cells = sin(q.x+sin(q.y))*cos(q.y+sin(q.x*.8));\nfloat broad = .5+.5*sin(p.x*2+p.y*1.7+t*.6);\nfloat veins = 1-smoothstep(.035,.16,abs(cells-.14));\nfloat radius = length(p);\nfloat ring = pow(.5+.5*sin(radius*14-t*3.8+sin(p.x*2+t)*.35),10)*RippleStrength*smoothstep(.5,.95,radius);\nfloat edge = smoothstep(2.02,2.18,max(abs(p.x),abs(p.y)))*EdgeFoam;\nColor = lerp(BaseColor,ShallowColor,saturate(.4+cells*.36+broad*.25));\nColor = lerp(Color,HighlightColor,saturate(veins*.33+ring*.65+edge));"
}

